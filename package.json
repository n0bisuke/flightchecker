{
  "name": "flightchecker",
  "version": "0.1.0",
  "private": true,
  "description": "航空券の価格を定期収集し、推移グラフと買い時の目安を GitHub Pages で表示する",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "analyze": "node scripts/analyze.mjs",
    "build": "node scripts/build-site.mjs",
    "demo": "node scripts/demo.mjs",
    "serve": "npm run build && npx --yes http-server _site -p 8080 -c-1",
    "test": "node --test test/*.test.mjs"
  },
  "optionalDependencies": {
    "playwright": "1.56.1"
  }
}
